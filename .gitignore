# Slurm logs: per-job noise.
out/

# Smoke runs (cluster/sweep.sbatch writes them to data/runs/archive/) and replaced
# data files; never tracked. graphtalk.analysis skips rows under any archive/.
archive/

# Prompt files are tracked (a response is only interpretable against its exact
# prompt), except these: each is rebuilt exactly by the script that writes it, or
# was never run in full.
/preliminary/data/prompts/prompts_got.count500.jsonl
/preliminary/data/prompts/prompts.retrieval.jsonl

# The Game-of-Thrones-named build of the 40-node prompts: no runs use it, and at
# 125 MB it is over GitHub's 100 MB file limit.
/data/prompts/prompts.densfull40.got.jsonl

# primer_flips.py output (16 MB), regenerable from the committed frame and runs.
/outputs/n40-sweep/primer_flips.csv

